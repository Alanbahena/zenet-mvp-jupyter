# =============================================================================
# Zenet MVP 0.1 - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git! It contains secrets.
#

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------
# Required for live integration tests and LLM-powered features.
#
# Obtain API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/account/keys

OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# -----------------------------------------------------------------------------
# Test Models (Optional)
# -----------------------------------------------------------------------------
# Live integration tests use these models to validate the LLM framework.
# If not set, tests will use the defaults shown below.
#
# Defaults are lightweight models chosen for cost-effectiveness.
# Estimated cost per full test run: ~$0.01
#
# Override these to test with different models when needed.

# OpenAI Test Model
# Default: gpt-4o-mini
# Cost: $0.15 input / $0.60 output per 1M tokens
#
# Alternative models:
#   - gpt-4o: $2.50 / $10.00 per 1M tokens (production model, 17x more expensive)
#   - gpt-4-turbo: $10.00 / $30.00 per 1M tokens
#   - gpt-3.5-turbo: $0.50 / $1.50 per 1M tokens
TEST_OPENAI_MODEL=gpt-4o-mini

# Anthropic Test Model
# Default: claude-haiku-4-5-20251001
# Cost: $0.80 input / $4.00 output per 1M tokens
#
# Alternative models:
#   - claude-sonnet-4-5: $3.00 / $15.00 per 1M tokens (production model, 4x more expensive)
#   - claude-sonnet-4-6: Similar pricing to 4-5
#   - claude-opus-4-6: Most expensive, highest quality
TEST_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - .env is gitignored and should never be committed
# - API keys are sensitive - keep them secure
# - Test models default to lightweight/cheap options
# - You can override test models temporarily:
#     TEST_OPENAI_MODEL=gpt-4o pytest tests/unit/ -k LiveOpenAi
